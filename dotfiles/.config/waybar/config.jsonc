{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "battery",
    "network",
    "pulseaudio",
    "pulseaudio#microphone",
    "bluetooth",
    "tray",
    "custom/power",
  ],
  "niri/workspaces": {
    "all-outputs": true,
    "format": "{value}",
  },
  "clock": {
    "format": "{:%H:%M | %d.%m.%y}",
    "format-alt": "󰥔  {:%H:%M}",
    "tooltip-format": "<tt><span size='13pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#dbbc7f'><b>{}</b></span>",
        "weekdays": "<span color='#859289'><b>{}</b></span>",
        "weeks": "<span color='#83c092'><b>W{}</b></span>",
        "today": "<span color='#2d353b' background='#dbbc7f'><b>{}</b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "cpu": {
    "interval": 5,
    "format": "  {usage}%",
  },
  "memory": {
    "interval": 5,
    "format": "  {}%",
  },
  // Wird nur angezeigt, wenn ein Akku (BAT*) vorhanden ist –
  // auf Desktop-Rechnern blendet Waybar das Modul automatisch aus.
  "battery": {
    "interval": 10,
    "states": {
      "warning": 25,
      "critical": 10,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹",
    ],
    // {status} gibt es in Waybar 0.15 nicht mehr -> Modul blieb leer
    "tooltip-format": "{capacity}%  ·  {power} W\n{time}\n{cycles} Zyklen · Gesundheit {health}",
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  LAN",
    "format-disconnected": "󰤭  Offline",
    "format-disconnected-alt": "󰤭  Offline",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "on-click": "nmcli radio wifi toggle",
    "on-click-right": "~/.config/waybar/scripts/network.sh",
    "tooltip-format": "WLAN: {essid}\n{ipaddr}\nLinks: Toggle | Rechts: Auswahl",
    "max-length": 18,
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Mute",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.config/waybar/scripts/pulseaudio.sh",
    "tooltip-format": "Lautsprecher: {desc}",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
  },
  "pulseaudio#microphone": {
    "source_name": "source",
    "scroll-step": 5,
    "format": "{format_source}",
    "format-source": "󰍬  {volume}%",
    "format-source-muted": "󰍭  Mute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "~/.config/waybar/scripts/microphone.sh",
    "tooltip-format": "Mikrofon: {source_desc}",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
  },
  "bluetooth": {
    "format": "{status}",
    "format-disabled": "󰂲",
    "format-enabled": "󰂯",
    "format-connected": "󰂯  {num_connections}",
    "format-device-preference": ["device1"],
    "on-click": "~/.config/waybar/scripts/rofi-bluetooth",
    "on-click-right": "~/.config/waybar/scripts/rofi-bluetooth",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} verbunden",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connections": "[{device_icon} {device_alias}]\t{device_address}",
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Power-Menü",
    "on-click": "~/.config/waybar/scripts/powermenu.sh",
  },
}
