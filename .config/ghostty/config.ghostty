font-size = 14
background-blur-radius = 20
mouse-hide-while-typing = true
window-decoration = false
language= de
background-blur = true
background-opacity = 0.96

theme = "Gruvbox Dark"

# Verhindert, dass Ghostty das Padding mit einer festen Farbe füllt
window-padding-color = background

# Verteilt den restlichen Platz (den "nicht-transparenten" Streifen) 
# gleichmäßig, sodass er oben und unten kaum noch auffällt
window-padding-balance = true

# Minimiert das Padding auf 0, damit das Raster so nah wie möglich 
# an den Rand rückt
# window-padding-x = 0
window-padding-y = 0


font-family = JetBrainsMono Nerd Font

font-thicken = true
command = tmux
